# ==============================================================================
# DesignProof Production Environment Configuration Template
# Copy this file to .env before starting the containers:
#   cp .env.example .env
# ==============================================================================

# --- SERVER / NETWORK PORTS ---
FRONTEND_PORT=80
BACKEND_PORT_FORWARD=5000
PYTHON_PORT_FORWARD=5001
DB_PORT_FORWARD=5432
REDIS_PORT_FORWARD=6379

# --- APPLICATION URLS ---
# Replace with your actual domain or VPS public IP (e.g. https://designproof.yourdomain.com or http://192.168.1.50)
FRONTEND_URL=http://localhost
VITE_API_BASE_URL=/api

# --- DATABASE CONFIGURATION (PostgreSQL) ---
DB_NAME=designproof_db
DB_USER=postgres
# IMPORTANT: Generate a strong password in production (e.g., openssl rand -hex 16)
DB_PASSWORD=designproof_secure_db_pass_2026

# --- SECURITY & SESSIONS ---
# IMPORTANT: Generate random 64-char keys for production:
#   openssl rand -hex 32
JWT_SECRET=super_secret_production_jwt_key_change_me_before_deploy
SESSION_SECRET=super_secret_session_key_change_me_before_deploy

# --- ENVIRONMENT MODES ---
NODE_ENV=production
FLASK_ENV=production

# --- EXTERNAL SERVICES & API KEYS ---
# SERP API Key for Google Lens / Web image reverse search
SERP_API_KEY=1b95936cad36a631f65641107670464ada508c9632be71250421689eeb382cbc

# Google OAuth (Optional - required if using Google Sign-In)
# Callback URL in Google Console: https://yourdomain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_placeholder
GOOGLE_CLIENT_SECRET=your_google_client_secret_placeholder

# GitHub OAuth (Optional - required if using GitHub Sign-In)
# Callback URL in GitHub Developer Settings: https://yourdomain.com/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id_placeholder
GITHUB_CLIENT_SECRET=your_github_client_secret_placeholder

# --- EMAIL / SMTP (For Takedown Notices & Notifications) ---
CLIENT_BRAND_NAME=DesignProof
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
EMAIL_USER=pccbr36cjh3ma7ip@ethereal.email
EMAIL_PASS=NkqGAzECg4NtfVZ3yx
